generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  email          String         @unique
  telephone      String?        @unique
  firstName      String
  lastName       String
  password       String
  profileImage   String?
  nationalId     String?

  //reset password
  resetOtp      String?
  resetOtpExpires DateTime?

  role           Role           @default(USER)
  gender         Gender         @default(OTHER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdArtists Artist[]       @relation("ArtistCreator")
  chatRooms      ChatRoomUser[]
  comments       Comment[]
  favArtists     FavArtist[]
  likes          Like[]
  messages       Message[]
  posts          Post[]
  createdEvents  Event[]        @relation("EventCreator")
  news           News[]         @relation("NewsCreator")
  createdChatRooms ChatRoom[]   @relation("ChatRoomCreator")
}

model Artist {
  id              Int           @id @default(autoincrement())
  artistName      String
  profileImage    String?
  biography       String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  agencyId        Int?
  createdByUserId Int?
  agency          Agency?       @relation(fields: [agencyId], references: [id])
  createdByUser   User?         @relation("ArtistCreator", fields: [createdByUserId], references: [id])
  events          ArtistEvent[]
  genres          ArtistGenre[]
  favByUsers      FavArtist[]
  postArtists     PostArtist[]
  songs           Song[]
  news            NewsArtist[]

  @@index([agencyId])
  @@index([createdByUserId])
}

model Agency {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  socialMedia String?
  artists     Artist[]
}

model Genre {
  id      Int           @id @default(autoincrement())
  name    String        @unique
  artists ArtistGenre[]
}

model ArtistGenre {
  artistId Int
  genreId  Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
}

model FavArtist {
  id        Int      @id @default(autoincrement())
  userId    Int
  artistId  Int
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([artistId])
}

model Post {
  id         Int         @id @default(autoincrement())
  title      String?
  content    String      @db.Text
  userId     Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  comments   Comment[]
  likes      Like[]
  postArtists PostArtist[]

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  postImages PostImage[]

  @@index([userId])
}

model PostArtist {
  postId   Int
  artistId Int
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([postId, artistId])
  @@index([artistId])
  @@index([postId])
}


model PostImage {
  id        Int      @id @default(autoincrement())
  url       String?  @db.Text
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  image     String?
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model Event {
  id              Int           @id @default(autoincrement())
  eventName       String
  description     String?       @db.Text
  posterImage     String?
  status          EventStatus   @default(UPCOMING)
  ticketLink      String?
  startTime       DateTime
  endTime         DateTime?
  venueId         Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  artists         ArtistEvent[]
  createdByUserId Int?
  createdByUser   User?         @relation("EventCreator", fields: [createdByUserId], references: [id])
  venue           Venue         @relation(fields: [venueId], references: [id])

  @@index([venueId])
  @@index([createdByUserId])
}

model ArtistEvent {
  artistId Int
  eventId  Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([artistId, eventId])
  @@index([eventId])
}

model Venue {
  id      Int     @id @default(autoincrement())
  name    String
  address String? @db.Text
  lat     Float
  lng     Float
  events  Event[]
  image   String?
}

model ChatRoom {
  id          Int            @id @default(autoincrement())
  isGroup     Boolean        @default(false)
  name        String?
  coverImage  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creatorId   Int?
  creator     User?          @relation("ChatRoomCreator", fields: [creatorId], references: [id])

  users       ChatRoomUser[]
  messages    Message[]
}

model ChatRoomUser {
  userId            Int
  chatRoomId        Int
  joinedAt          DateTime @default(now())
  lastReadMessageId Int?

  chatRoom          ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chatRoomId])
  @@index([chatRoomId])
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  senderId   Int
  chatRoomId Int
  createdAt  DateTime @default(now())

  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId])
  @@index([senderId])
}

model Song {
  id          Int       @id @default(autoincrement())
  title       String
  coverImage  String?
  duration    Int?
  streamUrl   String?
  popularity  Int       @default(0)
  releaseDate DateTime?
  isDemo      Boolean   @default(true)
  licenseNote String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  artistId    Int
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

model News {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  coverImage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorId     Int
  author       User     @relation("NewsCreator", fields: [authorId], references: [id])

  artists      NewsArtist[]

  @@index([authorId])
}

model NewsArtist {
  newsId   Int
  artistId Int
  news     News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([newsId, artistId])
  @@index([artistId])
}

enum Role {
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  CANCELED
  FINISHED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  X
}
