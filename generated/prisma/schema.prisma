generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id               Int            @id @default(autoincrement())
  username         String         @unique
  email            String         @unique
  telephone        String?        @unique
  firstName        String
  lastName         String
  password         String
  profileImage     String?
  nationalId       String?
  role             Role           @default(USER)
  gender           Gender         @default(OTHER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdArtists   Artist[]       @relation("ArtistCreator")
  chatRooms        ChatRoomUser[]
  comments         Comment[]
  favArtists       FavArtist[]
  likes            Like[]
  messages         Message[]
  posts            Post[]
  createdEvents    Event[]        @relation("EventCreator")
  news             News[]         @relation("NewsCreator")
  createdChatRooms ChatRoom[]     @relation("ChatRoomCreator")
}

model Artist {
  id           Int      @id @default(autoincrement())
  artistName   String
  profileImage String?
  biography    String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agencyId        Int?
  createdByUserId Int?
  agency          Agency?       @relation(fields: [agencyId], references: [id])
  createdByUser   User?         @relation("ArtistCreator", fields: [createdByUserId], references: [id])
  events          ArtistEvent[]
  genres          ArtistGenre[]
  favByUsers      FavArtist[]
  postArtists     PostArtist[] // ความสัมพันธ์กลับไปยัง Post
  songs           Song[]
  news            NewsArtist[]

  @@index([agencyId], map: "Artist_agencyId_fkey")
  @@index([createdByUserId], map: "Artist_createdByUserId_fkey")
}

model Agency {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.LongText
  socialMedia String?
  artists     Artist[]
}

model Genre {
  id      Int           @id @default(autoincrement())
  name    String        @unique
  artists ArtistGenre[]
}

model ArtistGenre {
  artistId Int
  genreId  Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId], map: "ArtistGenre_genreId_fkey")
}

model FavArtist {
  id        Int      @id @default(autoincrement())
  userId    Int
  artistId  Int
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([artistId], map: "FavArtist_artistId_fkey")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String   @db.LongText
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    Comment[]
  likes       Like[]
  postArtists PostArtist[]

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  postImages PostImage[]

  @@index([userId], map: "Post_userId_fkey")
}

model PostArtist {
  postId   Int
  artistId Int
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([postId, artistId])
  @@index([artistId])
  @@index([postId]) // ใช้ Composite Key เพื่อป้องกันการผูกศิลปินซ้ำในโพสต์เดียว
}

model PostImage {
  id        Int      @id @default(autoincrement())
  url       String?  @db.Text
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId], map: "PostImage_postId_fkey")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId], map: "Like_postId_fkey")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  image     String?
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId], map: "Comment_postId_fkey")
  @@index([userId], map: "Comment_userId_fkey")
}

model Event {
  id              Int           @id @default(autoincrement())
  eventName       String
  description     String?       @db.LongText
  posterImage     String?
  status          EventStatus   @default(UPCOMING)
  ticketLink      String?
  startTime       DateTime
  endTime         DateTime?
  venueId         Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  artists         ArtistEvent[]
  createdByUserId Int?
  createdByUser   User?         @relation("EventCreator", fields: [createdByUserId], references: [id])
  venue           Venue         @relation(fields: [venueId], references: [id])

  @@index([venueId], map: "Event_venueId_fkey")
  @@index([createdByUserId], map: "Event_createdByUserId_fkey")
}

model ArtistEvent {
  artistId Int
  eventId  Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([artistId, eventId])
  @@index([eventId], map: "ArtistEvent_eventId_fkey")
}

model Venue {
  id      Int     @id @default(autoincrement())
  name    String
  address String? @db.Text
  lat     Float
  lng     Float
  events  Event[]
  image   String?
}

model ChatRoom {
  id         Int      @id @default(autoincrement())
  isGroup    Boolean  @default(false)
  name       String? // เพิ่ม: สำหรับชื่อแชทกลุ่ม
  coverImage String? // เพิ่ม: สำหรับรูปแชทกลุ่ม
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creatorId Int? // เพิ่ม: สำหรับเก็บ ID คนสร้างกลุ่ม
  creator   User? @relation("ChatRoomCreator", fields: [creatorId], references: [id])

  users    ChatRoomUser[]
  messages Message[]
}

model ChatRoomUser {
  userId            Int
  chatRoomId        Int
  joinedAt          DateTime @default(now())
  lastReadMessageId Int? // เพิ่ม: เก็บ ID ของข้อความล่าสุดที่ User คนนี้อ่าน (แก้ปัญหา Read status ในแชทกลุ่ม)

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chatRoomId])
  @@index([chatRoomId], map: "ChatRoomUser_chatRoomId_fkey")
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  senderId   Int
  chatRoomId Int
  // เอา isRead ออก แล้วไปใช้ lastReadMessageId ใน ChatRoomUser แทน
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId], map: "Message_chatRoomId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
}

model Song {
  id          Int       @id @default(autoincrement())
  title       String
  coverImage  String?
  duration    Int?
  streamUrl   String?
  popularity  Int       @default(0)
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  artistId    Int
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId], map: "Song_artistId_fkey")
}

model News {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  coverImage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  //admin คนที่อัพเดทข่าว
  authorId Int
  author   User @relation("NewsCreator", fields: [authorId], references: [id])

  artists NewsArtist[]

  @@index([authorId])
}

model NewsArtist {
  newsId   Int
  artistId Int
  news     News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([newsId, artistId]) // ใช้คู่ ID เป็น Primary Key เพื่อป้องกันการแท็กซ้ำในข่าวเดียว
  @@index([artistId])
}

enum Role {
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  CANCELED
  FINISHED
}

enum AuthProvider {
  LOCAL // สมัครผ่านเว็บปกติ (กรอกรหัสผ่าน)
  GOOGLE
  FACEBOOK
  X
}
